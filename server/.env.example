# FlyDeal Server Configuration

# Server port
PORT=3001

# Environment
NODE_ENV=development

# CORS origin (use * for development, specific domain for production)
CORS_ORIGIN=*

# Database path (defaults to ./flydeal.db)
DB_PATH=./flydeal.db

# Amadeus API Configuration (optional - uses mock data if not set)
# Get your API credentials at https://developers.amadeus.com
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# Amadeus API Base URL
# Test environment: https://test.api.amadeus.com
# Production environment: https://api.amadeus.com
AMADEUS_BASE_URL=https://test.api.amadeus.com
